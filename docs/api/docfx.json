{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/SwiftCollections/bin/Release/net8.0/SwiftCollections.dll",
            "src/SwiftCollections.FixedMathSharp/bin/Release/net8.0/SwiftCollections.FixedMathSharp.dll"
          ],
          "src": "../.."
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "content": [
      { "files": ["index.md", "toc.yml"] },
      { "files": ["OVERVIEW.md"], "src": "..", "dest": "guides" },
      { "files": ["**/*.yml"], "src": "obj/api", "dest": "api" }
    ],
    "resource": [
      {
        "files": ["icon.png"],
        "src": "../..",
        "dest": "assets"
      }
    ],
    "overwrite": [{ "files": ["overrides/*.md"] }],
    "output": "obj/_site",
    "template": ["default", "modern", "templates/swiftcollections"],
    "globalMetadata": {
      "_appName": "SwiftCollections",
      "_appTitle": "SwiftCollections API",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_appLogoPath": "assets/icon.png",
      "_appFaviconPath": "assets/icon.png"
    }
  }
}
