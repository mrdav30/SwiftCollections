{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/SwiftCollections/bin/Release/net8.0/SwiftCollections.dll",
            "src/SwiftCollections.FixedMathSharp/bin/Release/net8.0/SwiftCollections.FixedMathSharp.dll"
          ],
          "src": "../.."
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "content": [
      { "files": ["index.md", "toc.yml"] },
      { "files": ["**/*.yml"], "src": "obj/api", "dest": "api" }
    ],
    "output": "obj/_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "SwiftCollections API"
    }
  }
}
